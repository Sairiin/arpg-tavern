/* Planner finale */
.planner-shell {
  width: 100% !important;
  max-width: 1160px !important;
  margin: 34px auto 48px !important;
  padding: 30px !important;
  border: 1px solid rgba(228, 168, 76, 0.38) !important;
  border-radius: 14px !important;
  background:
    radial-gradient(circle at 15% 0%, rgba(214, 145, 48, 0.12), transparent 32%),
    linear-gradient(145deg, rgba(42, 17, 8, 0.97), rgba(10, 5, 4, 0.98)) !important;
  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.38),
    inset 0 1px rgba(255, 207, 116, 0.12) !important;
}

.planner-shell-heading {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  margin: 0 0 24px !important;
  padding: 0 4px 18px !important;
  border-bottom: 1px solid rgba(228, 168, 76, 0.2) !important;
}

.planner-shell-heading > span {
  display: grid !important;
  place-items: center !important;
  width: 48px !important;
  height: 48px !important;
  flex: 0 0 48px !important;
  border: 1px solid rgba(228, 168, 76, 0.42) !important;
  border-radius: 12px !important;
  background: linear-gradient(145deg, #5b3217, #1d0c05) !important;
  color: #f0c878 !important;
  font-size: 1.65rem !important;
  line-height: 1 !important;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.3) !important;
}

.planner-shell-heading .eyebrow {
  margin: 0 0 5px !important;
  color: #d99b4c !important;
  font-size: 0.7rem !important;
  font-weight: 800 !important;
  letter-spacing: 0.18em !important;
  text-transform: uppercase !important;
}

.planner-shell-heading h2 {
  margin: 0 !important;
  color: #f3ddb2 !important;
  font-family: Georgia, serif !important;
  font-size: clamp(1.15rem, 2vw, 1.55rem) !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
  letter-spacing: 0.01em !important;
}

.planner-shell-frame {
  height: min(1400px, calc(100vh + 520px)) !important;
  min-height: 1100px !important;
  overflow: hidden !important;
  border: 1px solid rgba(228, 168, 76, 0.35) !important;
  border-radius: 10px !important;
  background: #050505 !important;
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.42),
    inset 0 0 0 1px rgba(255, 207, 116, 0.05) !important;
}

.planner-shell-frame iframe {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 1100px !important;
  border: 0 !important;
  background: #050505 !important;
  color-scheme: dark !important;
  scrollbar-width: none !important;
}

.planner-shell-frame iframe::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

@media (max-width: 640px) {
  .planner-shell {
    width: calc(100% - 30px) !important;
    margin: 24px auto 34px !important;
    padding: 20px 16px !important;
    border-radius: 10px !important;
  }

  .planner-shell-heading {
    gap: 12px !important;
    margin-bottom: 18px !important;
    padding-bottom: 14px !important;
  }

  .planner-shell-heading > span {
    width: 40px !important;
    height: 40px !important;
    flex-basis: 40px !important;
    font-size: 1.35rem !important;
  }

  .planner-shell-frame {
    height: 1100px !important;
    min-height: 1100px !important;
  }

  .planner-shell-frame iframe {
    min-height: 1100px !important;
  }
}


/* Layout uniforme pagina build + planner */
.build-detail-page {
  width: 100% !important;
  max-width: none !important;
}

.build-detail-page > * {
  width: min(1160px, calc(100% - 48px)) !important;
  max-width: 1160px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box !important;
}

.build-detail-page > .planner-shell {
  width: min(1160px, calc(100% - 48px)) !important;
  max-width: 1160px !important;
  margin: 34px auto 48px !important;
  padding: 28px !important;
  box-sizing: border-box !important;
  border: 1px solid rgba(228, 168, 76, 0.34) !important;
  border-radius: 6px !important;
  background:
    linear-gradient(
      145deg,
      rgba(99, 39, 14, 0.30),
      rgba(25, 8, 4, 0.92)
    ),
    #0b0504 !important;
  box-shadow:
    inset 0 1px rgba(255, 207, 116, 0.08),
    0 14px 35px rgba(0, 0, 0, 0.32) !important;
}

.build-detail-page > .planner-shell .planner-shell-frame {
  width: 100% !important;
  height: 900px !important;
  min-height: 900px !important;
  border: 1px solid rgba(228, 168, 76, 0.30) !important;
  border-radius: 6px !important;
  background: #000 !important;
  box-shadow:
    inset 0 0 0 1px rgba(255, 207, 116, 0.05),
    0 10px 28px rgba(0, 0, 0, 0.34) !important;
}

.build-detail-page > .planner-shell .planner-shell-frame iframe {
  width: 100% !important;
  height: 900px !important;
  min-height: 900px !important;
  border: 0 !important;
  background: #000 !important;
}

@media (max-width: 640px) {
  .build-detail-page > *,
  .build-detail-page > .planner-shell {
    width: calc(100% - 30px) !important;
  }

  .build-detail-page > .planner-shell {
    padding: 18px !important;
  }

  .build-detail-page > .planner-shell .planner-shell-frame,
  .build-detail-page > .planner-shell .planner-shell-frame iframe {
    height: 780px !important;
    min-height: 780px !important;
  }
}

.planner-shell-frame {
  background: #090604 !important;
  border-color: rgba(228, 168, 76, 0.24) !important;
  box-shadow:
    inset 0 0 0 1px rgba(255, 207, 116, 0.04),
    0 10px 28px rgba(0, 0, 0, 0.42) !important;
}

.planner-shell-frame iframe {
  background: #090604 !important;
  filter:
    brightness(0.62)
    saturate(0.72)
    sepia(0.12)
    hue-rotate(160deg) !important;
}

@media (max-width: 640px) {
  .planner-shell-frame iframe {
    filter:
      brightness(0.62)
      saturate(0.72)
      sepia(0.12)
      hue-rotate(160deg) !important;
  }
}

.planner-shell {
  border: 1px solid rgba(105, 76, 40, 0.42) !important;
  border-radius: 8px !important;
  background:
    linear-gradient(
      145deg,
      rgba(20, 9, 5, 0.98),
      rgba(7, 4, 3, 0.99)
    ) !important;
  box-shadow:
    inset 0 1px rgba(255, 207, 116, 0.035),
    0 14px 35px rgba(0, 0, 0, 0.42) !important;
}

.planner-shell-heading {
  margin-bottom: 22px !important;
  padding-bottom: 18px !important;
  border-bottom: 1px solid rgba(105, 76, 40, 0.32) !important;
}

.planner-shell-heading > span {
  border-color: rgba(105, 76, 40, 0.52) !important;
  background:
    linear-gradient(
      145deg,
      rgba(48, 27, 13, 0.95),
      rgba(12, 7, 4, 0.98)
    ) !important;
  color: #c79b58 !important;
  box-shadow:
    inset 0 1px rgba(255, 207, 116, 0.05),
    0 5px 18px rgba(0, 0, 0, 0.32) !important;
}

.planner-shell-heading .eyebrow {
  color: #a77b45 !important;
}

.planner-shell-heading h2 {
  color: #d6c09a !important;
}

.planner-shell-frame {
  border-color: rgba(105, 76, 40, 0.38) !important;
  border-radius: 7px !important;
  background: #050403 !important;
  box-shadow:
    inset 0 0 0 1px rgba(255, 207, 116, 0.025),
    0 10px 28px rgba(0, 0, 0, 0.5) !important;
}

.planner-shell-frame iframe {
  background: #050403 !important;
}

.planner-shell-frame iframe {
  filter: none !important;
  opacity: 1 !important;
  background: transparent !important;
}

.planner-shell-frame {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(38, 20, 10, 0.22),
      rgba(5, 4, 3, 0.98) 68%
    ) !important;
  border-color: rgba(105, 76, 40, 0.34) !important;
}

.planner-shell-frame::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: rgba(5, 4, 3, 0.22);
  z-index: 0;
}

.planner-shell-frame iframe {
  position: relative;
  z-index: 1;
}

button,
a[role="button"],
a.button,
.btn,
.detail-button,
.build-detail-page a[href],
.build-detail-page button {
  transition:
    transform 160ms ease,
    filter 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease,
    background-color 160ms ease !important;
}

button:hover,
a[role="button"]:hover,
a.button:hover,
.btn:hover,
.detail-button:hover,
.build-detail-page a[href]:hover,
.build-detail-page button:hover {
  transform: translateY(-2px) !important;
  filter: brightness(1.12) !important;
  border-color: rgba(255, 207, 116, 0.7) !important;
  box-shadow:
    0 7px 16px rgba(0, 0, 0, 0.32),
    0 0 14px rgba(228, 168, 76, 0.2) !important;
}

button:active,
a[role="button"]:active,
a.button:active,
.btn:active,
.detail-button:active,
.build-detail-page a[href]:active,
.build-detail-page button:active {
  transform: translateY(0) scale(0.98) !important;
  filter: brightness(0.98) !important;
}

button:focus-visible,
a[role="button"]:focus-visible,
a.button:focus-visible,
.btn:focus-visible,
.detail-button:focus-visible,
.build-detail-page a[href]:focus-visible,
.build-detail-page button:focus-visible {
  outline: 2px solid rgba(228, 168, 76, 0.72) !important;
  outline-offset: 3px !important;
}

/* Hover uniforme e pulito */
.build-detail-page a,
.build-detail-page button {
  transition:
    background 180ms ease,
    border-color 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease !important;
  transform: none !important;
  filter: none !important;
}

.build-detail-page a:hover,
.build-detail-page button:hover {
  transform: none !important;
  filter: none !important;
  color: #f3d39b !important;
  background:
    linear-gradient(
      180deg,
      rgba(111, 67, 28, 0.96),
      rgba(58, 29, 12, 0.98)
    ) !important;
  border-color: rgba(239, 188, 99, 0.72) !important;
  box-shadow:
    inset 0 1px rgba(255, 220, 145, 0.16),
    0 0 0 1px rgba(228, 168, 76, 0.12) !important;
}

.build-detail-page a:active,
.build-detail-page button:active {
  transform: none !important;
  filter: none !important;
  box-shadow:
    inset 0 1px rgba(0, 0, 0, 0.25) !important;
}

.build-detail-page a:focus-visible,
.build-detail-page button:focus-visible {
  outline: 2px solid rgba(228, 168, 76, 0.65) !important;
  outline-offset: 2px !important;
}

/* Ripristino effetto originale del link PoBB.in */
.build-detail-page a[href*="pobb.in"] {
  transform: none !important;
  filter: none !important;
  color: inherit !important;
  transition:
    transform 160ms ease,
    filter 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease,
    background-color 160ms ease !important;
}

.build-detail-page a[href*="pobb.in"]:hover {
  transform: translateY(-2px) !important;
  filter: brightness(1.12) !important;
  border-color: rgba(255, 207, 116, 0.7) !important;
  box-shadow:
    0 7px 16px rgba(0, 0, 0, 0.32),
    0 0 14px rgba(228, 168, 76, 0.2) !important;
}

/* Bagliore leggero senza alterare il resto dello stile */
.build-detail-page a:not([href*="pobb.in"]):hover,
.build-detail-page button:hover {
  transform: none !important;
  filter: none !important;
  background: inherit !important;
  color: inherit !important;
  border-color: rgba(255, 207, 116, 0.6) !important;
  box-shadow:
    0 0 9px rgba(228, 168, 76, 0.32),
    inset 0 0 7px rgba(228, 168, 76, 0.08) !important;
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}

/* Reset uniforme degli effetti interattivi */
.build-detail-page a,
.build-detail-page button {
  transform: none !important;
  filter: none !important;
  transition:
    box-shadow 180ms ease,
    border-color 180ms ease !important;
}

.build-detail-page a:hover,
.build-detail-page button:hover,
.build-detail-page a:focus,
.build-detail-page button:focus,
.build-detail-page a:active,
.build-detail-page button:active {
  transform: none !important;
  filter: none !important;
  background: revert !important;
  color: revert !important;
  box-shadow:
    0 0 9px rgba(228, 168, 76, 0.32),
    inset 0 0 7px rgba(228, 168, 76, 0.08) !important;
  border-color: rgba(255, 207, 116, 0.6) !important;
}

.build-detail-page a:focus-visible,
.build-detail-page button:focus-visible {
  outline: 2px solid rgba(228, 168, 76, 0.65) !important;
  outline-offset: 2px !important;
}

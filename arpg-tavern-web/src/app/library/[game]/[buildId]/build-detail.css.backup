
.build-planner-card {
  width: 100%;
  overflow: hidden;
  background: #000;
}

.build-planner-card .detail-card-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.build-planner-status {
  margin-left: auto;
  padding: 0.3rem 0.6rem;
  border: 1px solid #35516d;
  border-radius: 999px;
  color: #a9d1ff;
  background: #0e1a27;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
}

.build-planner-frame {
  width: 100%;
  height: clamp(700px, 88vh, 1100px);
  overflow: hidden;
  background: #000;
  border: 1px solid #2b323b;
  border-radius: 0.75rem;
}

.build-planner-frame iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #000;
  color-scheme: dark;
}

@media (max-width: 600px) {
  .build-planner-status {
    display: none;
  }

  .build-planner-frame {
    height: 780px;
    border-radius: 0.5rem;
  }
}

.build-planner-card {
  width: 100%;
  margin: 1.5rem 0;
  overflow: hidden;
  background: #000;
}

.build-planner-frame {
  width: 100%;
  height: clamp(700px, 88vh, 1100px);
  overflow: hidden;
  background: #000;
  border: 1px solid #2b323b;
  border-radius: 0.75rem;
}

.build-planner-frame iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #000;
  color-scheme: dark;
}

@media (max-width: 600px) {
  .build-planner-frame {
    height: 780px;
  }
}


/* Planner PoB incorporato */
.build-planner-card {
  width: min(1160px, calc(100% - 48px));
  margin: 18px auto 0;
  padding: 28px;
  overflow: hidden;
  border: 1px solid rgba(228, 168, 76, 0.24);
  border-radius: 6px;
  background: linear-gradient(
    145deg,
    rgba(99, 39, 14, 0.28),
    rgba(25, 8, 4, 0.84)
  );
  box-shadow:
    inset 0 1px rgba(255, 207, 116, 0.08),
    0 12px 32px rgba(0, 0, 0, 0.24);
}

.build-planner-card .detail-card-title {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 22px;
}

.build-planner-card .detail-card-title > div {
  min-width: 0;
}

.build-planner-card .detail-card-title h2 {
  margin: 0;
  color: #f1d7a4;
  font-family: Georgia, serif;
  font-size: 1.34rem;
}

.build-planner-status {
  margin-left: auto;
  flex: 0 0 auto;
  border: 1px solid rgba(232, 175, 82, 0.32);
  border-radius: 999px;
  padding: 7px 10px;
  color: #e0b36d;
  background: rgba(20, 6, 3, 0.46);
  font-size: 0.7rem;
  text-transform: uppercase;
}

.build-planner-frame {
  width: 100%;
  height: clamp(700px, 88vh, 1100px);
  overflow: hidden;
  border: 1px solid rgba(228, 168, 76, 0.3);
  border-radius: 6px;
  background: #000;
  box-shadow:
    inset 0 0 0 1px rgba(255, 207, 116, 0.05),
    0 10px 28px rgba(0, 0, 0, 0.34);
}

.build-planner-frame iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #000;
  color-scheme: dark;
  filter: none;
}

@media (max-width: 640px) {
  .build-planner-card {
    width: calc(100% - 30px);
    padding: 22px 18px;
  }

  .build-planner-status {
    display: none;
  }

  .build-planner-frame {
    height: 780px;
  }
}

.planner-shell {
  display: block;
  width: min(1160px, calc(100% - 48px));
  max-width: 1160px;
  margin: 24px auto 0;
  padding: 28px;
  box-sizing: border-box;
  overflow: hidden;
  border: 1px solid rgba(228, 168, 76, 0.34);
  border-radius: 6px;
  background:
    linear-gradient(
      145deg,
      rgba(99, 39, 14, 0.3),
      rgba(25, 8, 4, 0.92)
    ),
    #0b0504;
  box-shadow:
    inset 0 1px rgba(255, 207, 116, 0.08),
    0 14px 35px rgba(0, 0, 0, 0.32);
}

.planner-shell-heading {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 22px;
}

.planner-shell-heading h2 {
  margin: 0;
  color: #f1d7a4;
  font-family: Georgia, serif;
  font-size: 1.34rem;
}

.planner-shell-frame {
  width: 100%;
  height: clamp(700px, 88vh, 1100px);
  overflow: hidden;
  border: 1px solid rgba(228, 168, 76, 0.38);
  border-radius: 6px;
  background: #000;
}

.planner-shell-frame iframe {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 700px;
  border: 0;
  background: #000;
  color-scheme: dark;
}

@media (max-width: 640px) {
  .planner-shell {
    width: calc(100% - 30px);
    padding: 22px 18px;
  }

  .planner-shell-frame,
  .planner-shell-frame iframe {
    height: 780px;
    min-height: 780px;
  }
}

.build-detail-page {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
}

.build-detail-page > * {
  flex: 0 0 auto;
}

.build-detail-page > .build-detail-topbar,
.build-detail-page > .build-detail-hero,
.build-detail-page > .build-detail-layout,
.build-detail-page > .build-detail-message,
.build-detail-page > .build-variants-container,
.build-detail-page > .planner-shell {
  width: min(1160px, calc(100% - 48px)) !important;
  max-width: 1160px !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.build-detail-page > .planner-shell {
  align-self: center !important;
  display: block !important;
  position: relative !important;
  float: none !important;
  clear: both !important;
  box-sizing: border-box !important;
  height: auto !important;
  min-width: 0 !important;
  transform: none !important;
}

.build-detail-page > .planner-shell .planner-shell-frame {
  display: block !important;
  width: 100% !important;
  height: clamp(700px, 88vh, 1100px) !important;
  min-width: 0 !important;
  overflow: hidden !important;
}

.build-detail-page > .planner-shell .planner-shell-frame iframe {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  min-height: 700px !important;
  border: 0 !important;
  background: #000 !important;
}

@media (max-width: 640px) {
  .build-detail-page > .planner-shell,
  .build-detail-page > .build-detail-topbar,
  .build-detail-page > .build-detail-hero,
  .build-detail-page > .build-detail-layout,
  .build-detail-page > .build-detail-message,
  .build-detail-page > .build-variants-container {
    width: calc(100% - 30px) !important;
  }

  .build-detail-page > .planner-shell .planner-shell-frame,
  .build-detail-page > .planner-shell .planner-shell-frame iframe {
    height: 780px !important;
    min-height: 780px !important;
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * Le build sono private:
     * ogni account può leggere e modificare soltanto
     * users/{proprio UID}/builds/{buildId}.
     */
    match /users/{userId}/builds/{buildId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    /*
     * Nessun'altra collection è esposta finché non viene
     * aggiunta esplicitamente una regola dedicata.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

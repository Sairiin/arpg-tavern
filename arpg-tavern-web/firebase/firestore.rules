rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * Build private: ogni account può leggere e modificare
     * soltanto le proprie build.
     */
    match /users/{userId}/builds/{buildId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      /*
       * Varianti della build: stesso proprietario della build padre.
       */
      match /variants/{variantId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    /*
     * Nessun'altra collection è esposta.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
